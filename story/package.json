{
  "name": "ica-backhaul-story",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Fifteen Links Over Ica: scroll-driven story and live simulator of the Electro Dunas backhaul",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "build": "bash scripts/build.sh",
    "validate": "node --experimental-transform-types --no-warnings scripts/validate.ts 7",
    "export-results": "python3 scripts/export_results.py"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@parcel/config-default": "^2.16.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "html-inline": "^1.2.0",
    "parcel": "^2.16.4",
    "parcel-resolver-tspaths": "^0.0.9",
    "postcss": "^8.5.29",
    "tailwindcss": "3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
